<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false" />

    <!-- LEFT: channels in the active category. Opened/closed with D-pad LEFT. -->
    <LinearLayout
        android:id="@+id/channel_sidebar"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#1A1D24"
        android:visibility="gone">

        <TextView
            android:id="@+id/channel_sidebar_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/category_all_channels"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="#15171C" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channel_sidebar_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- RIGHT: category picker. Opened/closed with D-pad RIGHT. Selecting one updates the left sidebar. -->
    <LinearLayout
        android:id="@+id/category_sidebar"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#1A1D24"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/label_categories"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="#15171C" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/category_sidebar_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="8dp" />

    </LinearLayout>

    <!-- RIGHT (opened with D-pad UP, both LIVE and VOD): Audio + Subtitles track picker. -->
    <LinearLayout
        android:id="@+id/tracks_sidebar"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#1A1D24"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/label_audio_tracks"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#15171C" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/audio_tracks_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="240dp"
            android:paddingTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/label_subtitle_tracks"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#15171C" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/subtitle_tracks_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="4dp" />

    </LinearLayout>

    <!-- BOTTOM: VOD transport controls (movies/TV show episodes only) — play/pause indicator,
         elapsed/remaining time and a scrub bar. Shown with D-pad DOWN/UP, auto-hides. D-pad
         LEFT/RIGHT seek instead of opening the live channel/category sidebars, and DPAD_CENTER
         toggles play/pause — see PlayerActivity's VOD key handling. -->
    <LinearLayout
        android:id="@+id/vod_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#CC000000"
        android:visibility="gone">

        <TextView
            android:id="@+id/vod_title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/vod_play_pause_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_player_pause"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/vod_position_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:minWidth="44dp" />

            <ProgressBar
                android:id="@+id/vod_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                android:max="1000"
                android:progressTint="#1565C0" />

            <TextView
                android:id="@+id/vod_duration_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:minWidth="44dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- BOTTOM: channel info bar. Shown with D-pad DOWN, auto-hides after a few seconds. -->
    <LinearLayout
        android:id="@+id/info_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#CC000000"
        android:visibility="gone">

        <ImageView
            android:id="@+id/info_bar_logo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/info_bar_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/info_bar_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#6FA8DC"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/info_bar_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/info_bar_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="end" />

            <TextView
                android:id="@+id/info_bar_resolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:gravity="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/info_bar_bitrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:gravity="end"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
